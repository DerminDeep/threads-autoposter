# Threads AutoPoster Configuration

# Telegram Bot (Required)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_IDS=123456789,987654321

# Publishing Method: api or browser
PUBLISH_METHOD=api

# Meta API Credentials (Required if PUBLISH_METHOD=api)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# CloakBrowser (Required if PUBLISH_METHOD=browser)
CLOAKBROWSER_CDP_URL=http://localhost:9222

# AI Provider: openai or anthropic
AI_PROVIDER=openai

# AI API Configuration
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=your_api_key
AI_MODEL=llama3
AI_TIMEOUT=120

# Scheduler
DEFAULT_POSTS_PER_DAY=3
DEFAULT_POST_TIMES=10:00,15:00,20:00

# Logging
LOG_LEVEL=INFO
